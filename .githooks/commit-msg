#!/bin/sh
# Validate the first header independently of body text.
IFS= read -r headline < "$1" || { printf 'Cannot read commit header\n' >&2; exit 1; }
if ! printf '%s\n' "$headline" | grep -Eq '^(feat|fix|build|chore|docs|style|ci|refactor|perf|test|revert)\([a-z0-9][a-z0-9./-]*\)!?: [^[:space:]](.*[^[:space:]])?$'; then
    printf 'Required commit header: type(scope): description (optional ! before colon)\n' >&2
    exit 1
fi
command -v cog >/dev/null 2>&1 || { printf 'cocogitto is required\n' >&2; exit 1; }
cog verify --file "$1" >/dev/null || { printf 'Invalid Conventional Commit\n' >&2; exit 1; }
